menu "LMS filter"

    config LMS_SAMPLE_RATE_HZ
        int "Sample rate"
        default 16000
        range 8000 48000
        help
            Default sample rate used by the PC simulation.

    config LMS_TAPS
        int "Number of LMS taps"
        default 64
        range 1 512
        help
            FIR length of the adaptive reference path model.

    config LMS_MU_Q15
        int "Classic LMS learning rate in Q15"
        default 1
        range 0 32767
        help
            Learning rate encoded as Q15. Smaller values improve stability.

    config LMS_ADAPT_SHIFT
        int "Extra LMS adaptation right shift"
        default 20
        range 0 30
        help
            Additional right shift applied to the weight update. This allows
            effective learning rates smaller than one Q15 LSB while keeping
            input/reference samples unscaled.

    config LMS_OUTPUT_LIMIT
        int "Output saturation limit"
        default 32767
        range 1 32767
        help
            Absolute saturation limit for output samples.

endmenu
